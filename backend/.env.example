# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Cryptography & Token Secrets (PLACEHOLDERS ONLY - Never commit real keys)
JWT_ACCESS_SECRET=placeholder_vault_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=placeholder_vault_refresh_token_secret_min_32_chars
KMS_MASTER_KEY=placeholder_operational_kms_master_key_for_db_encryption_only

# Database Connection (Leave empty or set to :memory: for in-memory SQLite engine)
DATABASE_URL=sqlite::memory:
USE_IN_MEMORY_DB=true

# Security & Throttling
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000
STEP_UP_TTL_SECONDS=120

# Email Delivery Provider (Server-side only - Resend or SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_placeholder_server_key_here
RESEND_FROM_EMAIL=KeyNest <invites@yourdomain.com>
APP_URL=http://localhost:3000
# SMTP Alternative:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@yourdomain.com
# SMTP_PASS=placeholder_smtp_pass
