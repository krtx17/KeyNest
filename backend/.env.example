# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Cryptography & Token Secrets (PLACEHOLDERS ONLY - Never commit real keys)
JWT_ACCESS_SECRET=placeholder_vault_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=placeholder_vault_refresh_token_secret_min_32_chars
KMS_MASTER_KEY=placeholder_operational_kms_master_key_for_db_encryption_only

# Database Connection (Persistent SQLite on disk by default; set to true for in-memory)
DATABASE_URL=vaultshare.sqlite
USE_IN_MEMORY_DB=false

# Security & Throttling
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000
STEP_UP_TTL_SECONDS=120

# Email Delivery Provider (Server-side only - Resend or Gmail / Custom SMTP)
APP_URL=http://localhost:3000

# Option A: Resend API
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_placeholder_server_key_here
# RESEND_FROM_EMAIL=KeyNest <invites@yourdomain.com>

# Option B: Gmail SMTP (Use a Google App Password from myaccount.google.com/apppasswords)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_app_password
# RESEND_FROM_EMAIL=KeyNest <your_email@gmail.com>

